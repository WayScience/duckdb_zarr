# name: test/sql/duckdb_zarr.test
# description: metadata tests for duckdb_zarr
# group: [sql]

statement error
SELECT * FROM zarr_groups('test/data/simple_v2.zarr');
----
Catalog Error: Table Function with name zarr_groups does not exist!

require duckdb_zarr

query III
SELECT group_path, zarr_format, metadata_path LIKE '%simple_v2.zarr/%'
FROM zarr_groups('test/data/simple_v2.zarr')
ORDER BY group_path;
----
/	2	1
stations	2	1

query I
SELECT COUNT(*)
FROM zarr_groups('test/data/simple_v2.zarr')
WHERE metadata_path LIKE '%/.zmetadata#%';
----
2

query IIIIIIIII
SELECT
    array_path,
    rank,
    shape::VARCHAR,
    chunk_shape::VARCHAR,
    dtype,
    "order",
    COALESCE(NULLIF(compressor, ''), '<none>'),
    dimension_separator,
    metadata_path LIKE '%simple_v2.zarr/%'
FROM zarr_arrays('test/data/simple_v2.zarr')
ORDER BY array_path;
----
half_precision	2	[2, 2]	[2, 2]	<f2	C	<none>	.	1
mask	2	[2, 3]	[2, 2]	|b1	C	<none>	.	1
sparse_fill	2	[2, 3]	[2, 2]	<i4	C	<none>	.	1
stations/elevation	1	[2]	[2]	<i4	C	<none>	/	1
temperature	2	[4, 3]	[2, 2]	<f8	C	{"id":"gzip","level":1}	.	1

query IIIII
SELECT
    array_path,
    chunk_key,
    chunk_coords::VARCHAR,
    file_size_bytes > 0,
    file_path LIKE '%simple_v2.zarr/%'
FROM zarr_chunks('test/data/simple_v2.zarr')
ORDER BY array_path, chunk_key;
----
half_precision	0.0	[0, 0]	1	1
mask	0.0	[0, 0]	1	1
mask	0.1	[0, 1]	1	1
sparse_fill	0.0	[0, 0]	1	1
stations/elevation	0	[0]	1	1
temperature	0.0	[0, 0]	1	1
temperature	0.1	[0, 1]	1	1
temperature	1.0	[1, 0]	1	1
temperature	1.1	[1, 1]	1	1

query II
